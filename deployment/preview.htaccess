# Only for test.schier.dk; never published to the production target.
RewriteEngine On
RewriteCond %{HTTP_HOST} !^test\.schier\.dk(?::[0-9]+)?$ [NC]
RewriteRule ^ - [F,L]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://test.schier.dk%{REQUEST_URI} [R=302,L]
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>
DirectoryIndex index.html
ErrorDocument 404 /404.html
